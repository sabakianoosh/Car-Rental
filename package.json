{
  "name": "rikar-car-rental",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev": "concurrently \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "seed": "npm run seed -w server",
    "pdf": "node scripts/generate-prd-pdf.mjs",
    "docx": "node scripts/generate-prd-docx.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "puppeteer-core": "^24.2.0"
  },
  "dependencies": {
    "@turbodocx/html-to-docx": "^1.22.2",
    "cheerio": "^1.2.0"
  }
}
